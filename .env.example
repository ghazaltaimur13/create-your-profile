# Copy to .env.local (not committed). Used by Next.js API routes.
#
# Release version: bump the "version" field in package.json — it appears in the site footer
# and in GET /api/health so you can confirm the server is running a new build.

JWT_SECRET=replace-with-a-long-random-string

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=portfolio_app

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/?upgrade=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/?upgrade=cancelled

# Optional: only if the browser calls a different API origin
# NEXT_PUBLIC_API_BASE_URL=
